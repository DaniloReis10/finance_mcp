{
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "pluggy-connect-sdk": "^2.14.2",
    "zod": "^4.6.7"
  },
  "name": "open-finance-desktop",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Open Finance pessoal com desktop macOS, sincronização diária e MCP",
  "scripts": {
    "start": "node src/server.js",
    "build": "esbuild src/browser.js --bundle --format=esm --outfile=public/bundle.js --minify && npm run build:server",
    "test": "node --test",
    "desktop": "node scripts/launch.js",
    "install:mac": "node scripts/install-mac.js",
    "build:server": "esbuild src/server.js --bundle --platform=node --format=esm --banner:js=\"import {createRequire} from 'node:module';const require=createRequire(import.meta.url);\" --outfile=src/server.bundle.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
